{
  "name": "el-dar-demo",
  "version": "1.0.0",
  "description": "El-Dar Desktop Application (Demo)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --windows"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.eldar.demo",
    "productName": "El-Dar-Demo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "el-dar.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "El-Dar Demo"
    },
    "files": [
      "main.js",
      "index.html",
      "data/**/*",
      "el-dar.ico",
      "el-dar.png"
    ],
    "extraResources": [
      {
        "from": "publish",
        "to": "publish"
      },
      {
        "from": "data",
        "to": "data"
      }
    ]
  }
}
@using ElDarBLL.ViewModel.HomeVM
@model SearchViewModel

<link href="~/css/Data.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

@{
    ViewData["Title"] = "Search Results";

    dynamic? activePaginatedList = null;
    if (Model?.Guests != null && Model.Guests.Any())
    {
        activePaginatedList = Model.Guests;
    }
    else if (Model?.Employees != null && Model.Employees.Any())
    {
        activePaginatedList = Model.Employees;
    }
    else if (Model?.DataList != null && Model.DataList.Any())
    {
        activePaginatedList = Model.DataList;
    }

    var queryParams = Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString());
}

<h2 style="text-align: center;">Search Results</h2>

@if (Model != null)
{
    @if (Model.Guests != null && Model.Guests.Any())
    {
        var Counter = 0;
        <h3 class="mt-4">Guests</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-name">No.</th>
                    <th class="col-name">Name</th>
                    <th class="col-number">PhoneNumber</th>
                    <th class="col-name">CardNumber</th>
                    <th class="col-name">Address</th>
                    <th class="col-number">Price</th>
                    <th class="col-number">OutPrice</th>
                    <th class="col-name">Status</th>
                    <th class="col-number">Age</th>
                    <th class="col-date">DateOfBirth</th>
                    <th class="col-paid">Paid</th>
                    <th class="col-deleted">Deleted</th>
                    <th class="col-notes">Notes</th>
                    <th class="col-number">Buttons</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var guest in Model.Guests)
                {
                    Counter++;
                    <tr>
                        <td class="col-name">@Counter</td>
                        <td class="col-name">@guest.Name</td>
                        <td class="col-number">@guest.PhoneNumber</td>
                        <td class="col-name">@guest.CardNumber</td>
                        <td class="col-name">@guest.Address</td>
                        <td class="col-number">@guest.Price.ToString("N2")</td>
                        <td class="col-number">@(guest.OutPrice.HasValue ? guest.OutPrice.Value.ToString("N2") : "───")</td>
                        <td class="col-name">@guest.Status.ToString()</td>
                        <td class="col-number">@guest.Age.ToString()</td>
                        <td class="col-date">@guest.DateOfBirth.ToString("yyyy-MM-dd")</td>
                        <td class="col-paid">@(guest.IsPaid == true ? "Paid" : "Not paid")</td>
                        <td class="col-number">
                            <form action="ConvertDelete?id=@guest.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn-status @(guest.IsDeleted ? "status-deleted" : "status-active")">
                                    @(guest.IsDeleted ? "Deleted" : "Not deleted")
                                </button>
                            </form>
                        </td>

                        <td class="col-notes">@(!string.IsNullOrEmpty(guest.Notes) ? guest.Notes : "───")</td>
                        <td class="col-number" style="white-space: nowrap; width: 120px;">
                            <a href="/Guest/UpdateGuestView?id=@guest.Id" class="button-edit" style="text-decoration: none;">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <form action="/Guest/DeleteGuest?id=@guest.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this guest? ⚠️');">
                                <button type="submit" class="button-delete">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Employees != null && Model.Employees.Any())
    {
        var Counter = 0;
        <h3 class="mt-4">Employees</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-name">No.</th>
                    <th class="col-name">Name</th>
                    <th class="col-number">PhoneNumber</th>
                    <th class="col-number">CardNumber</th>
                    <th class="col-name">Address</th>
                    <th class="col-name">Job</th>
                    <th class="col-number">Salary</th>
                    <th class="col-number">Adds</th>
                    <th class="col-number">Taxs</th>
                    <th class="col-number">Total</th>
                    <th class="col-paid">Paid</th>
                    <th class="col-date">DateOfBirth</th>
                    <th class="col-number">Age</th>
                    <th class="col-deleted">Deleted</th>
                    <th class="col-notes">Notes</th>
                    <th class="col-number">Buttons</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model.Employees)
                {
                    Counter++;
                    <tr>
                        <td class="col-name">@Counter</td>
                        <td class="col-name">@employee.Name</td>
                        <td class="col-number">@employee.PhoneNumber</td>
                        <td class="col-number">@employee.CardNumber</td>
                        <td class="col-name">@employee.Address</td>
                        <td class="col-name">@employee.Job.ToString()</td>
                        <td class="col-number">@employee.Salary</td>
                        <td class="col-number">@(employee.Adds.HasValue ? employee.Adds.Value.ToString("N2") : "───")</td>
                        <td class="col-number">@(employee.Taxs.HasValue ? employee.Taxs.Value.ToString("N2") : "───")</td>
                        <td class="col-number">@employee.Total</td>
                        <td class="col-paid">@(employee.IsPaid == true ? "Paid" : "Not paid")</td>
                        <td class="col-date">@employee.DateOfBirth.ToString("yyyy-MM-dd")</td>
                        <td class="col-number">@employee.Age</td>
                        <td class="col-number">
                            <form action="ConvertDelete?id=@employee.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn-status @(employee.IsDeleted ? "status-deleted" : "status-active")">
                                    @(employee.IsDeleted ? "Deleted" : "Not deleted")
                                </button>
                            </form>
                        </td>
                        <td class="col-notes">@(!string.IsNullOrEmpty(employee.Notes) ? @employee.Notes : "───")</td>
                        <td class="col-number" style="white-space: nowrap; width: 120px;">
                            <a href="/Employee/UpdateEmployeeView?id=@employee.Id" class="button-edit" style="text-decoration: none;">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <form action="/Employee/DeleteEmployee?id=@employee.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this employee? ⚠️');">
                                <button type="submit" class="button-delete">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.DataList != null && Model.DataList.Any())
    {
        var Counter = 0;
        <h3 class="mt-4">Data Log</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-name">No.</th>
                    <th class="col-name">Name</th>
                    <th class="col-number">Revenues</th>
                    <th class="col-number">Payments</th>
                    <th class="col-number">Price</th>
                    <th class="col-number">OutPrice</th>
                    <th class="col-number">Payment</th>
                    <th class="col-date">Date</th>
                    <th class="col-deleted">Deleted</th>
                    <th class="col-notes">Notes</th>
                    <th class="col-number">Buttons</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var data in Model.DataList)
                {
                    Counter++;
                    <tr>
                        <td class="col-name">@Counter</td>
                        <td class="col-name">@data.Name</td>
                        <td class="col-number">@(data.Revenues.HasValue ? data.Revenues.ToString() : "───")</td>
                        <td class="col-number">@(data.Payments.HasValue ? data.Payments.ToString() : "───")</td>
                        <td class="col-number">@(data.Price.HasValue ? data.Price.Value.ToString("N2") : "───")</td>
                        <td class="col-number">@(data.OutPrice.HasValue ? data.OutPrice.Value.ToString("N2") : "───")</td>
                        <td class="col-number">@(data.Payment.HasValue ? data.Payment.Value.ToString("N2") : "───")</td>
                        <td class="col-date">@(data.Date.ToString("yyyy-MM-dd"))</td>
                        <td class="col-deleted">
                            <form action="ConvertDelete?id=@data.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn-status @(data.IsDeleted  ? "status-deleted" : "status-active")">
                                    @(data.IsDeleted ? "Deleted" : "Not deleted")
                                </button>
                            </form>
                        </td>
                        <td class="col-notes">@(data.Notes ?? "───")</td>
                        <td class="col-number" style="white-space: nowrap; width: 120px;">
                            <a href="/Data/UpdateDataView?id=@data.Id" class="button-edit" style="text-decoration: none;">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <form action="/Data/DeleteData?id=@data.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this Data? ⚠️');">
                                <button type="submit" class="button-delete">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (activePaginatedList != null)
    {
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 25px; margin-bottom: 15px;">
            <div style="display: flex; gap: 6px; align-items: center; justify-content: center; font-size: 15px; flex-wrap: wrap;">

                @if (activePaginatedList.HasPreviousPage)
                {
                    queryParams["pageNumber"] = (activePaginatedList.PageIndex - 1).ToString();
                    <a asp-action="SearchData" asp-all-route-data="queryParams" style="text-decoration: none; color: #0d6efd; font-weight: 600; padding: 2px 6px;">Previous</a>
                }
                else
                {
                    <span style="color: #94a3b8; cursor: not-allowed; padding: 2px 6px;">Previous</span>
                }

                @for (int i = 1; i <= activePaginatedList.TotalPages; i++)
                {
                    if (i == activePaginatedList.PageIndex)
                    {
                        <span style="font-weight: bold; color: #0d6efd; text-decoration: underline; text-underline-offset: 4px; padding: 2px 6px;">@i</span>
                    }
                    else
                    {
                        queryParams["pageNumber"] = i.ToString();
                        <a asp-action="SearchData" asp-all-route-data="queryParams" style="text-decoration: none; color: #0d6efd; padding: 2px 6px;">@i</a>
                    }
                }

                @if (activePaginatedList.HasNextPage)
                {
                    queryParams["pageNumber"] = (activePaginatedList.PageIndex + 1).ToString();
                    <a asp-action="SearchData" asp-all-route-data="queryParams" style="text-decoration: none; color: #0d6efd; font-weight: 600; padding: 2px 6px;">Next</a>
                }
                else
                {
                    <span style="color: #94a3b8; cursor: not-allowed; padding: 2px 6px;">Next</span>
                }

            </div>

            <div>
                <span style="color: #64748b; font-size: 13px;">
                    Page <b>@activePaginatedList.PageIndex</b> of <b>@activePaginatedList.TotalPages</b> (Total Records: <b>@activePaginatedList.TotalCount</b>)
                </span>
            </div>
        </div>
    }

    @if ((Model.Guests == null || !Model.Guests.Any()) &&
         (Model.Employees == null || !Model.Employees.Any()) &&
         (Model.DataList == null || !Model.DataList.Any()))
    {
        <div class="alert alert-warning mt-4 text-center">
            No results found matching your search.
        </div>
    }
}
@using System.Text.RegularExpressions
@using ElDarBLL.ViewModel.EmployeeVM
@using ElDarDal.Models.Enums
@model IEnumerable<EmployeeVM>

<style>
.data-table {
    position: relative;
    right: 40px; 
}
    .custom-alert {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 20px;
    margin: 15px auto;
    width: 80%;
    max-width: 500px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
}

.alert-danger {
    background-color: #fde8e8;
    color: #9b1c1c;
    border: 1px solid #f8b4b4;
}

.custom-alert i {
    font-size: 18px;
    color: #e02424;
}
</style>
@{
    ViewData["Title"] = "Employees";
}
<link rel="stylesheet" href="/css/Data.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<h3>Employees</h3>

@if (ViewBag.PhoneAndCardErrorMessage != null || ViewBag.FailedToAddEmployeeMessage != null)
{
    var errorMessage = ViewBag.PhoneAndCardErrorMessage ?? ViewBag.FailedToAddEmployeeMessage;
    <div class="custom-alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>@errorMessage</span>
    </div>
}

<div class="table-panel">
    <div id="addGuestContainer" class="main-form" style="margin-top: 20px;">
        <form action="/Employee/CreateEmployee" method="post" id="addGuestForm">
            <div class="div-inputs">
                <input style="width: 250px; margin-bottom: 8px;" required name="Name" type="text" placeholder="Name:" autocomplete="off" />
                <input style="width: 250px; margin-bottom: 8px;" required name="PhoneNumber" type="text" inputmode="numeric" placeholder="Phone Number:" maxlength="11" pattern="^01[0125][0-9]{8}$" autocomplete="off" />
                <br>
                <input style="width: 250px; margin-bottom: 8px;" required name="CardNumber" type="text" inputmode="numeric" placeholder="Card Number:" maxlength="14" pattern="^[0-9]{14}$" autocomplete="off" />                
                <select class="GuestStatus" style="width: 250px; margin-bottom: 8px;" default-value="@Status.Active" required name="Status">
                    @foreach (var status in Enum.GetValues(typeof(Status)))
                    {
                        <option class="GuestStatus" value="@status">@status</option>
                    }
                </select>                <br>
                <input style="width: 250px; margin-bottom: 8px;" name="Address" type="text" placeholder="Address:" autocomplete="off" />
                <select class="GuestStatus" style="width: 250px; margin-bottom: 8px;" required name="Job">
                    @foreach (var job in Enum.GetValues(typeof(JobEnum)))
                    {
                        <option class="GuestStatus" value="@job" selected>@job</option>
                    }
                </select>
                <br>
                <input style="width: 250px; margin-bottom: 8px;" name="Salary" type="number" placeholder="Salary:" />
                <input style="width: 250px; margin-bottom: 8px;" name="Adds" type="number" placeholder="Adds:" />
                <br>
                <input style="width: 250px; margin-bottom: 8px;" name="Taxs" type="number" placeholder="Taxs:" />
                <input style="width: 250px; margin-bottom: 8px;" name="DateOfBirth" required type="date" placeholder="Date of Birth:" />
                <br>
                <input style="width: 510px; margin-bottom: 8px;" name="Notes" type="text" placeholder="Notes:" autocomplete="off" />
                <br>
                <button type="submit" class="button-submit" id="btnSaveEmployee">Save Employee</button>
                <hr>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    var Counter = 0;
    <table class="data-table">
        <thead>
            <tr>
                <th class="col-name">No.</th>
                <th class="col-name">Name</th>
                <th class="col-number">PhoneNumber</th>
                <th class="col-number">CardNumber</th>
                <th class="col-name">Address</th>
                <th class="col-name">Job</th>
                <th class="col-name">Status</th>
                <th class="col-number">Salary</th>
                <th class="col-number">Adds</th>
                <th class="col-number">Taxs</th>
                <th class="col-number">Total</th>
                <th class="col-paid">Paid</th>
                <th class="col-date">DateOfBirth</th>
                <th class="col-number">Age</th>
                <th class="col-notes">Notes</th>
                <th class="col-number">Buttons</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var employee in Model)
            {
                Counter++;
                <tr>
                    <td class="col-name">@Counter</td>
                    <td class="col-name">@employee.Name</td>
                    <td class="col-number">@employee.PhoneNumber</td>
                    <td class="col-number">@employee.CardNumber</td>
                    <td class="col-name">@employee.Address</td>
                    <td class="col-name">@employee.Job.ToString()</td>
                    <td class="col-name">@employee.Status.ToString()</td>
                    <td class="col-number">@employee.Salary</td>
                    <td class="col-number">@(employee.Adds.HasValue ? employee.Adds.Value.ToString("N2") : "───")</td>
                    <td class="col-number">@(employee.Taxs.HasValue ? employee.Taxs.Value.ToString("N2") : "───")</td>
                    <td class="col-number">@employee.Total</td>
                    <td class="col-paid">@(employee.IsPaid == "True" ? "Paid" : "Not paid")</td>
                    <td class="col-date">@employee.DateOfBirth?.ToString("yyyy-MM-dd")</td>
                    <td class="col-number">@employee.Age</td>
                    <td class="col-notes">@(!string.IsNullOrEmpty(employee.Notes) ? @employee.Notes : "───")</td>
                    <td class="col-number" style="white-space: nowrap; width: 120px;">
                        <a href="/Employee/UpdateEmployeeView?id=@employee.Id" class="button-edit" style="text-decoration: none;">
                            <i class="fa-solid fa-pen-to-square" style="color: white; margin-right: 4px;"></i>
                        </a>


                        <form action="/Employee/ConvertDelete?id=@employee.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this employee? ⚠️');">
                            <button type="submit" class="button-delete">
                                <i class="fa fa-trash" style="color: white; margin-right: 4px;"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }

        </tbody>
    </table>
}
else
{
    <table>
        <tr>
            <td colspan="9" style="text-align:center; padding: 20px;">No Employees For Now</td>
        </tr>
    </table>
}

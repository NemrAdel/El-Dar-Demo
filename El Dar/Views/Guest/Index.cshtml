@using ElDarBLL.ViewModel.GuestVM
@model IEnumerable<GuestVM>
<style>
    .custom-alert {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 20px;
        margin: 15px auto;
        width: 80%;
        max-width: 500px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    }

    .alert-danger {
        background-color: #fde8e8;
        color: #9b1c1c;
        border: 1px solid #f8b4b4;
    }

    .custom-alert i {
        font-size: 18px;
        color: #e02424;
    }
</style>

@{
    ViewData["Title"] = "Guests";
}
<link rel="stylesheet" href="/css/Data.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<h3>Guests</h3>

@if (ViewBag.PhoneAndCardErrorMessage != null || ViewBag.FailedToAddGuestMessage != null)
{
    var errorMessage = ViewBag.PhoneAndCardErrorMessage ?? ViewBag.FailedToAddGuestMessage;
    <div class="custom-alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>@errorMessage</span>
    </div>
}
<div class="table-panel">
    <div id="addGuestContainer" class="main-form" style="margin-top: 20px;">

        <form action="/Guest/CreateGuest" method="post" id="addGuestForm">
            <div class="div-inputs">
                <input style="width: 250px; margin-bottom: 8px;" required name="Name" type="text" placeholder="Name:" autocomplete="off" />
                <input style="width: 250px; margin-bottom: 8px;" required name="PhoneNumber" type="text" inputmode="numeric" placeholder="Phone Number:" maxlength="11" pattern="^01[0125][0-9]{8}$" autocomplete="off" />
                <br>
                <input style="width: 250px; margin-bottom: 8px;" required name="CardNumber" type="text" inputmode="numeric" placeholder="CardNumber:" maxlength="14" pattern="^[0-9]{14}$" autocomplete="off" />
                <br>
                <input style="width: 250px; margin-bottom: 8px;" name="Address" type="text" placeholder="Address:" autocomplete="off" />
                <input style="width: 250px; margin-bottom: 8px;" required name="Price" type="number" placeholder="Price:" />
                <br>
                <input style="width: 250px; margin-bottom: 8px;" name="OutPrice" type="number" placeholder="Out Price:" />
                <input style="width: 250px; margin-bottom: 8px;" name="DateOfBirth" type="date" required placeholder="Date of Birth:" />
                <br>
                <input style="width: 510px; margin-bottom: 8px;" name="Notes" type="text" placeholder="Notes:" autocomplete="off" />
                <br>
                <button type="submit" class="button-submit" id="btnSaveGuest">Save Guest</button>
                <hr>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
    {
        var Counter = 0;
        <table class="data-table">
        <thead>
            <tr>
                <th class="col-name">No.</th>
                <th class="col-name">Name</th>
                <th class="col-number">PhoneNumber</th>
                <th class="col-name">CardNumber</th>
                <th class="col-name">Address</th>
                <th class="col-number">Price</th>
                <th class="col-number">OutPrice</th>
                <th class="col-name">Status</th>
                <th class="col-number">Age</th>
                <th class="col-date">DateOfBirth</th>
                <th class="col-paid">Paid</th>
                <th class="col-notes">Notes</th>
                <th class="col-number">Buttons</th>
            </tr>
        </thead>
        <tbody>
            
                @foreach (var guest in Model)
                {
                    Counter++;
                    <tr>
                        <td class="col-name">@Counter</td>
                        <td class="col-name">@guest.Name</td>
                        <td class="col-number">@guest.PhoneNumber</td>
                        <td class="col-name">@guest.CardNumber</td>
                        <td class="col-name">@guest.Address</td>
                        <td class="col-id">@guest.Price.ToString("N2")</td>
                        <td class="col-id">@(guest.OutPrice.HasValue? guest.OutPrice.Value.ToString("N2") : "───")</td>
                        <td class="col-id">@guest.Status?.ToString()</td>
                        <td class="col-id">@guest.Age.ToString()</td>
                        <td class="col-id">@guest.DateOfBirth?.ToString("yyyy-MM-dd")</td>
                        <td class="col-id">@(guest.IsPaid=="True" ? "Paid" : "Not paid")</td>
                        <td class="col-id">@(!string.IsNullOrEmpty(guest.Notes) ? guest.Notes : "───")</td>
                        <td class="col-id" style="white-space: nowrap; width: 120px;">
                            <a href="/Guest/UpdateGuestView?id=@guest.Id" class="button-edit" style="text-decoration: none;">
                                <i class="fa-solid fa-pen-to-square" style="color: white; margin-right: 4px;"></i>
                                </a>
                            <form action="/Guest/ConvertDelete?id=@guest.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this guest? ⚠️');">
                                <button type="submit" class="button-delete">
                                    <i class="fa fa-trash" style="color: white; margin-right: 4px;"></i> 
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                
        </tbody>
    </table>
    }
else
{
    <table class="data-table">
        <tr>
            <td colspan="9" style="text-align:center; padding: 20px;">No Guests For Now</td>
        </tr>
    </table>
}

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm border-0 rounded-4 p-4" style="max-width: 420px; width: 100%;">
        
        <h3 class="fw-bold text-center mb-2 text-dark">Set New Password</h3>
        <p class="text-muted text-center small mb-4">Please enter your new password below.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small rounded-3 mb-3">
                @ViewBag.Error
            </div>
        }

        <form action="ResetPassword" method="post">
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">New Password</label>
                <input type="password" name="newPassword" class="form-control py-2 px-3 border-light-subtle rounded-3" minlength="8" placeholder="••••••••" required />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary small">Confirm New Password</label>
                <input type="password" name="confirmPassword" class="form-control py-2 px-3 border-light-subtle rounded-3" minlength="8" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn w-100 py-2.5 rounded-3 text-white fw-bold" style="background-color: #0b132b; border: none; font-size: 0.95rem;">
                Update Password
            </button>
        </form>
    </div>
</div>
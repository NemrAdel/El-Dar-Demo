@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm border-0 rounded-4 p-4" style="max-width: 420px; width: 100%;">
        
        <h3 class="fw-bold text-center mb-2 text-dark">Forgot Password?</h3>
        <p class="text-muted text-center small mb-4">Enter your registered email address to receive a password reset link.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small rounded-3 mb-3">
                @ViewBag.Error
            </div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success py-2 small rounded-3 mb-3">
                @ViewBag.Success
            </div>
        }

        <form action="ForgotPassword" method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">Email Address</label>
                <input type="email" name="email" class="form-control py-2 px-3 border-light-subtle rounded-3" placeholder="name@example.com" required />
            </div>

            <button type="submit" class="btn w-100 py-2.5 rounded-3 text-white fw-bold mb-3" style="background-color: #0b132b; border: none; font-size: 0.95rem;">
                Send Reset Link
            </button>

            <div class="text-center">
                <a href="Login">
                    ← Back to Login
                </a>
            </div>
        </form>
    </div>
</div>